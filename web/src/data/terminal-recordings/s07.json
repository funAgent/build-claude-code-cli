    { "type": "output", "text": "mycli v0.7.0  [Cost Tracking]\n命令: /cost 查看成本 | /exit 退出\n\n", "color": "green" },
    { "type": "prompt", "text": "you>" },
    { "type": "input", "text": "/cost", "typeDelay": 30 },
    { "type": "output", "text": "\n--- 成本统计 ---\n模型: claude-sonnet-4-20250514\nAPI 调用次数: 0\n输入 tokens: 0\n输出 tokens: 0\n总成本: $0.000000\n\n", "color": "cyan" }
