    { "type": "input", "text": "mycli \"帮我看看当前目录结构\"", "typeDelay": 40 },
    { "type": "output", "text": "\nyou> 帮我看看当前目录结构\n\n", "color": "white" },
    { "type": "output", "text": "assistant> 好的，让我看看目录内容。\n\n", "color": "cyan" },
    { "type": "output", "text": "  [tool] bash({\"command\":\"ls -la\"})\n", "color": "yellow" },
    { "type": "output", "text": "  [result] total 32\n-rw-r--r-- package.json\ndrwxr-xr-x src/\n\n", "color": "white" },
    { "type": "output", "text": "assistant> 这是一个 Node.js 项目，包含 package.json 和 src 目录。\n", "color": "cyan" },
