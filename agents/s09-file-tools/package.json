{
  "name": "s09-file-tools",
  "version": "0.9.0",
  "description": "AI Agent CLI — s09: File Tools",
  "private": true,
  "type": "module",
  "bin": {
    "mycli": "./dist/cli.mjs"
  },
  "scripts": {
